# AutoTruth AI runs fully offline with no keys (rule-based claim extraction).
# Set these to switch claim extraction to an LLM. Any OpenAI-compatible endpoint works.

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Leave empty for OpenAI. Examples:
#   Ollama (Llama): http://localhost:11434/v1   (LLM_API_KEY=ollama, LLM_MODEL=llama3.1)
#   Gemini:         https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# "auto" uses embeddings when fastembed is available, otherwise BM25 only.
RETRIEVAL_MODE=auto

# Optional NLI model (needs requirements-nli.txt)
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# 0 = strict: a review of a model year with no sheet on file is unverifiable.
# N = fall back to the nearest sheet within N model years (the verdict says so).
MODEL_YEAR_TOLERANCE=0
